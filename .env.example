# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@localhost:5432/taskdb

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

ACCESS_TOKEN_EXPIRE_MINUTES=60
SQL_ECHO=false

# Development only: create Calven (admin), Mahymar and Sothearith on first start.
SEED_DEMO_USERS=false
SEED_PASSWORD=
